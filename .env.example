# ============================================================
# Vocero CRM — variables de entorno
# Copia este archivo a `.env` y reemplaza cada REEMPLAZA_...
# En producción estas variables van en tu plataforma de hosting
# (Coolify / docker compose), no solo en el archivo.
# ============================================================

# --- Aplicación ---------------------------------------------
# URL pública del CRM (con https en producción). De ella se construyen la URL
# del webhook de WhatsApp y el redirect de auth, así que apunta al SUBDOMINIO
# de gestión, no a la raíz: la raíz la sirve la web pública de la marca.
# En desarrollo, `http://admin.localhost:<puerto>` deja la web pública en
# `http://localhost:<puerto>` (los *.localhost resuelven a loopback).
APP_BASE_URL=REEMPLAZA_https://admin.tudominio.com

# --- Web pública y CRM (ruteo por host) ----------------------
# Una instancia sirve DOS superficies con el mismo despliegue:
#   - la RAÍZ del dominio  → web pública de la marca + catálogo
#   - `admin.<dominio>`    → el CRM (gestión)
# Por eso APP_BASE_URL debe apuntar al host del CRM (de ahí salen el webhook
# de WhatsApp y el redirect de auth), y ADMIN_HOST declara ese mismo host.
#   APP_BASE_URL=https://admin.lamasfood.cl
#   ADMIN_HOST=admin.lamasfood.cl
# Opcional: si se deja vacío se deriva de APP_BASE_URL y, en su defecto, se
# asume la convención `admin.*`. Ver src/lib/hosts.ts.
# OJO: la convención es el prefijo `admin.` (con punto). Un dominio como
# `admin-lamasfood.duckdns.org` NO matchea, pero sí se deriva bien de
# APP_BASE_URL, así que alcanza con esa.
ADMIN_HOST=

# URL absoluta de la web pública (raíz del dominio). Se usa para el canonical y
# el Open Graph de las páginas: un canonical que apunte al subdominio de gestión
# sería un error de SEO.
# Se deriva de APP_BASE_URL quitándole el prefijo `admin.`, pero ESO SOLO
# FUNCIONA SI EL DOMINIO DEL ADMIN ES UN SUBDOMINIO DEL PÚBLICO. Con dominios
# hermanos (p. ej. admin-lamasfood.duckdns.org vs lamasfood.duckdns.org) hay que
# declararla SI O SI, o el canonical del sitio apuntaría al admin.
SITE_BASE_URL=

# --- Dominios (Ruta B: HTTPS automático de Caddy) -------------
# DOS dominios, uno por superficie. La app decide cuál sirve mirando el Host,
# así que ambos apuntan al MISMO servicio.
SITE_DOMAIN=REEMPLAZA_lamasfood.cl
ADMIN_DOMAIN=REEMPLAZA_admin.lamasfood.cl

# --- Base de datos ------------------------------------------
# Ruta B usa el servicio interno `postgres` del compose.
# Genera la contraseña con:  openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZA_password_de_postgres
DATABASE_URL=postgresql://postgres:REEMPLAZA_password_de_postgres@postgres:5432/vocero

# --- Secretos de la aplicación ------------------------------
# Firma de sesiones. Genera con:  openssl rand -base64 32
BETTER_AUTH_SECRET=REEMPLAZA_secreto_de_sesiones

# Cifrado en reposo del token de WhatsApp (AES-256-GCM).
# DEBE ser exactamente 32 bytes en base64 (44 caracteres).
# Genera con:  openssl rand -base64 32
ENCRYPTION_KEY=REEMPLAZA_clave_de_cifrado_base64

# --- WhatsApp (webhook) -------------------------------------
# Token de verificación del webhook. Es también el segmento secreto
# de la URL del webhook: /api/webhooks/wa/<este_valor>
# Genera con:  openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=REEMPLAZA_token_de_verificacion

# OPCIONAL (recomendado en modo directo): App Secret de tu app de Meta
# para validar la firma de cada webhook (x-hub-signature-256).
# Se obtiene en developers.facebook.com → tu app → Configuración → Básica.
# En modo agencia normalmente se deja vacío (la URL secreta protege el webhook).
# META_APP_SECRET=

# Versión de la Graph API (déjala así salvo que sepas por qué cambiarla).
META_GRAPH_API_VERSION=v25.0

# Gate de adjuntos entrantes: por defecto los archivos adjuntos de WhatsApp
# (imagen/audio/video/documento/sticker) se ignoran y el bot responde un aviso.
# Ponlo en true para habilitar la descarga y el almacenamiento completo.
# WA_INBOUND_MEDIA_ENABLED=true

# --- Inteligencia artificial (opcional) ---------------------
# Sin token, el CRM funciona completo excepto Agente y Laboratorio.
# Crea tu key en https://openrouter.ai → Keys (o usa cualquier proveedor
# compatible con la API de OpenRouter cambiando OPENROUTER_BASE_URL).
# OPENROUTER_API_TOKEN=
# OPENROUTER_BASE_URL=https://openrouter.ai/api
#
# ⚠️ Entorno de PRUEBAS (WA_MOCK_ENABLED=true): los canales externos DEBEN ser
# locales, porque un self-test jamás puede gastar dinero ni escribirle a
# clientes reales. El código rechaza un proveedor LLM remoto en modo pruebas.
#   WA_MOCK_ENABLED=true
#   OPENROUTER_BASE_URL=http://localhost:3000/api/dev/ai-mock
#   META_GRAPH_BASE_URL=http://localhost:3000/api/dev/wa-mock/graph
# Modelo principal del agente (ej.: anthropic/claude-sonnet-4.5)
# OPENROUTER_MODEL=
# Modelo del juez del Laboratorio (si se omite, usa el principal)
# OPENROUTER_JUDGE_MODEL=
# OPENROUTER_REASONING_EFFORT=medium   # nivel de razonamiento (low|medium|high); vacío = default del modelo
# Temperatura de muestreo (0-2). Vacío = default del modelo. Bajarla mejora la
# repetibilidad de los datos del negocio (precios, plazos); subirla aumenta la
# variedad. Aplica a conversación, anotación y juez por igual.
# OPENROUTER_TEMPERATURE=0.3

# --- Operación (opcional) -----------------------------------
# Reabrir el registro público después de la primera organización.
# ALLOW_SIGNUP=true

# Zona horaria IANA del negocio. Define la fecha y hora que el agente inyecta en
# su prompt para razonar sobre plazos y días de atención. Debe ser una zona IANA
# válida; un valor inexistente detiene el arranque.
# BUSINESS_TIMEZONE=America/Santiago

# Milisegundos de agrupación de mensajes antes del turno del agente (default 6000).
# AGENT_COALESCE_MS=6000

# --- Cerebro externo (opcional) -----------------------------
# Si en vez del agente in-process prefieres tu propio bot (un microservicio en
# el mismo servidor), habilita la API de servicio /api/bot/* con una API key:
# el bot marca leído + "escribiendo…", descarga adjuntos y reinicia la
# conversación de pruebas SIN que el token de WhatsApp salga del CRM.
# Genera una larga y aleatoria (mínimo 16 caracteres); sin ella, /api/bot/*
# responde 401 y el CRM funciona igual con su agente propio.
#   openssl rand -base64 32
# BOT_API_KEY=

# 008 - Directorio del volumen local de adjuntos (imagenes, docs, audios).
# En Coolify: montar un persistent storage en /data/media y poner esa ruta aqui.
# En dev local puede quedar el default relativo.
MEDIA_DIR=./.dev-media

# --- Web Push (opcional) ------------------------------------
# Notificaciones push cuando la IA escala a un humano (handoff). Sin estas
# claves, el push queda deshabilitado y la app funciona normal (solo no avisa
# en el móvil). Genera un par con:
#   node scripts/generate-vapid.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@correo.com   # identifica al servidor (opcional)
